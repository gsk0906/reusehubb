# =============================================================================
# ReUseHub Environment Configuration Template
# Copy this file to .env and fill in your values
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=your_jwt_secret_change_in_production_min32chars
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=reusehub_db
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem  # Optional: For cloud databases requiring CA certificates

# Default Administrator Seed Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# Frontend Configuration
# Leave blank to use relative URL with Vite dev proxy, or provide full API base URL
VITE_API_URL=
